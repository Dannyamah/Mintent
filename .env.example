# Copy to .env and fill in. Never commit .env. Leave a line empty to use the default.
# The relayer reads this file, and values already set in the environment win.
# Near keys stay in ~/.near-credentials unless RELAYER_PRIVATE_KEY is set.

# --- Network ---
NEAR_NETWORK=testnet                       # testnet | mainnet

# --- Mintent deployment ---
MINTENT_CONTRACT_ID=                       # the deployed contract, e.g. mintent.yourname.near
RELAYER_ACCOUNT=                           # NEAR account the relayer signs as, e.g. mintent-relayer.yourname.near
RELAYER_PRIVATE_KEY=                       # SECRET. Optional: only where ~/.near-credentials isn't available, such as a server
RELAYER_DB=relayer.sqlite                  # path to the order database. On a server, keep it on a persistent disk
PORT=8787
WEB_ORIGIN=                                # the web app's origin, e.g. https://yourdomain. Empty allows any origin

# --- Solana RPC ---
# Mainnet: use a provider that keeps history, because the double-payment check reads old transactions.
# Key from https://dashboard.helius.dev (free tier available). Looks like https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=                            # SECRET when it holds a key. Default: public RPC for the network

# --- NEAR RPC ---
# Optional. Free public endpoints are the default: https://docs.near.org/api/rpc/providers
NEAR_RPC_URL=                              # the main endpoint
NEAR_RPC_URLS=                             # extra endpoints to fail over to, comma separated

# --- NEAR Intents 1Click ---
# Optional, but swaps cost 0.25% more without it. Sign in at https://partners.near-intents.org
# Docs: https://docs.near-intents.org/integration/distribution-channels/1click-api/authentication
ONECLICK_JWT=                              # SECRET. Only ever sent to 1click.chaindefuser.com
ONECLICK_BASE_URL=                         # leave empty. Default: Tidepool on testnet, 1Click on mainnet

# --- Mintent fee ---
SERVICE_FEE_BPS=                           # leave empty for the default, 100 (1%)

# --- Testnet only ---
DEMO_FUNDER=                               # NEAR testnet account holding test USDC from https://app.usetidepool.tech/faucet

# --- Web app ---
# These live in apps/web/.env.local. See apps/web/.env.example.
