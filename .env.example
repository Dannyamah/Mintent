# Copy to .env and fill in. Never commit .env. Private keys stay in ~/.near-credentials, not here.

# --- NEAR ---
NEAR_NETWORK=testnet                       # testnet | mainnet
NEAR_DEV_ACCOUNT=                          # e.g. mintent-dev-xxxx.testnet (key in ~/.near-credentials/<network>/)
MINTENT_CONTRACT_ID=                       # deployed mintent contract
MPC_CONTRACT_ID=v1.signer-prod.testnet     # mainnet: v1.signer

# --- Solana ---
SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Collector Crypt ---
CC_GACHA_BASE_URL=https://dev-gacha.collectorcrypt.com   # mainnet: https://gacha.collectorcrypt.com
CC_API_BASE_URL=https://dev-api.collectorcrypt.com       # mainnet: https://api.collectorcrypt.com

# --- NEAR Intents 1Click ---
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=                              # optional; from https://partners.near-intents.org (else +25 bps)
ONECLICK_APP_FEE_BPS=0
ONECLICK_APP_FEE_RECIPIENT=

# --- Web app ---
NEXT_PUBLIC_PRIVY_APP_ID=
