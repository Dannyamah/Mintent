# Copy to apps/web/.env.local. Every value here is built into the public website, so never put a secret in this file.

# From https://dashboard.privy.io (App settings). Use the App ID only, never the App Secret.
VITE_PRIVY_APP_ID=

# Where the relayer runs. Empty means http://localhost:8787
VITE_RELAYER_URL=

# The contract this build trusts. Required on mainnet: the app refuses to sign without it. Optional on testnet.
VITE_MINTENT_CONTRACT=
